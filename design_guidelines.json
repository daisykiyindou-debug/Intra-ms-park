{
  "theme": "LIGHT",
  "archetype": "Corporate-Tech Premium",
  "typography": {
    "primary_font": "Satoshi",
    "fallback_font": "Plus Jakarta Sans",
    "font_weights": {
      "light": "300",
      "regular": "400",
      "medium": "500",
      "bold": "700",
      "black": "900"
    },
    "scale": {
      "h1": "text-4xl md:text-5xl tracking-tight font-bold",
      "h2": "text-2xl md:text-3xl tracking-tight font-bold",
      "h3": "text-xl font-bold",
      "h4": "text-lg font-medium",
      "body": "text-base leading-relaxed text-[#071B34]/80",
      "small": "text-sm text-[#071B34]/60",
      "overline": "text-xs uppercase tracking-[0.2em] font-medium"
    }
  },
  "colors": {
    "brand": {
      "primary": "#3BA4FF",
      "primary_hover": "#2A8DE0",
      "primary_active": "#1D70B8",
      "primary_focus_ring": "rgba(59, 164, 255, 0.3)",
      "midnight": "#071B34",
      "midnight_hover": "#0B2545",
      "midnight_active": "#0A1B2E"
    },
    "background": {
      "app": "#F4F7FA",
      "card_solid": "#FFFFFF",
      "card_glass": "rgba(255, 255, 255, 0.85)",
      "sidebar": "#071B34"
    },
    "text": {
      "main": "#071B34",
      "muted": "#475569",
      "inverse": "#FFFFFF"
    },
    "status": {
      "en_service": { "color": "#10B981", "bg": "#D1FAE5" },
      "pause": { "color": "#F59E0B", "bg": "#FEF3C7" },
      "hors_site": { "color": "#64748B", "bg": "#F1F5F9" },
      "fin_service": { "color": "#3BA4FF", "bg": "#E0F2FE" },
      "error": { "color": "#EF4444", "bg": "#FEE2E2" },
      "warning": { "color": "#F59E0B", "bg": "#FEF3C7" }
    },
    "borders": {
      "light": "rgba(7, 27, 52, 0.06)",
      "glass": "rgba(255, 255, 255, 0.6)"
    }
  },
  "visual_enhancers": {
    "glassmorphism": {
      "blur": "backdrop-blur-xl",
      "background": "bg-white/85",
      "border": "border border-white/60",
      "shadow": "shadow-[0_8px_30px_rgb(7,27,52,0.04)]"
    },
    "cards": {
      "radius": "rounded-2xl",
      "padding": "p-6",
      "shadow_hover": "hover:shadow-[0_12px_40px_rgb(7,27,52,0.08)]",
      "transition": "transition-all duration-300 ease-out"
    }
  },
  "motion": {
    "durations": {
      "fast": "150ms",
      "normal": "300ms",
      "slow": "500ms"
    },
    "easing": {
      "out": "cubic-bezier(0.16, 1, 0.3, 1)",
      "in_out": "cubic-bezier(0.65, 0, 0.35, 1)"
    },
    "interactions": {
      "hover_lift": "-translate-y-1",
      "active_scale": "active:scale-95",
      "slide_in": "animate-in slide-in-from-right duration-300"
    }
  },
  "layout": {
    "sidebar": {
      "width": "w-64",
      "state": "fixed left-0 top-0 h-screen",
      "mobile": "collapsible via hamburger menu",
      "bg": "bg-[#071B34]"
    },
    "header": {
      "height": "h-20",
      "state": "sticky top-0 z-40",
      "glass": "backdrop-blur-md bg-[#F4F7FA]/80"
    },
    "main_content": {
      "padding": "p-6 md:p-8 lg:p-10",
      "margin_left": "ml-0 md:ml-64"
    },
    "grid": {
      "bento": "grid grid-cols-1 md:grid-cols-4 lg:grid-cols-12 gap-6"
    }
  },
  "component_rules": {
    "icons": "lucide-react",
    "buttons": "rounded-xl font-medium px-6 py-2.5 transition-all duration-300 active:scale-95",
    "inputs": "rounded-xl border border-[#071B34]/10 bg-white px-4 py-2.5 focus:ring-2 focus:ring-[#3BA4FF]/30 focus:border-[#3BA4FF] outline-none transition-all",
    "badges": "rounded-full px-3 py-1 text-xs font-semibold uppercase tracking-wider"
  },
