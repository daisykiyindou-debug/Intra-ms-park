  },
  "pages": {
    "Dashboard": {
      "layout": "bento grid",
      "elements": [
        "Welcome message + Photo (col-span-full md:col-span-8)",
        "Weather Widget + Status Live (col-span-full md:col-span-4)",
        "Premium News Carousel (col-span-full md:col-span-8 row-span-2)",
        "KPI Widgets (Hours, Presence) (col-span-4)",
        "Quick Access Links (col-span-4)"
      ]
    },
    "Points_Repas": {
      "elements": [
        "Animated circular progress bars for points (20/30/35 depending on role)",
        "Purchase history list",
        "Badge status message: 'Badgeage uniquement sur site' (No button)"
      ]
    },
    "Restauration": {
      "elements": [
        "Digital menu food-app style (Donut House, Soccer Bar)",
        "Product cards: image top, title, price, points. (rounded-2xl, glassmorphism)",
        "Cart drawer",
        "Pickup time selector & QR code generator"
      ]
    },
    "Mon_Coin_RH": {
      "sections": [
        "Planning: Monthly calendar, clickable days (Hours, 45m break, Manager)",
        "Badgeage: History list, anomalies highlighted in red",
        "Demandes: Forms with date picker, approval workflow timeline"
      ]
    },
    "Actualites_Entreprise": {
      "elements": "LinkedIn/Workplace style feed. Author, timestamp, image, like/comment actions. Max width 3xl centered."
    },
    "Documents_RH": {
      "elements": "Grid of folders/files. Mocked PDF preview modal."
    },
    "Notifications": {
      "elements": "Slide-in panel from right. Real-time feel. Unread indicators."
    },
    "Avantages": {
      "elements": "Partner discount cards with QR codes. Masonry or Grid layout."
    },
    "Contacts": {
      "elements": "Directory grid with avatars, role, phone. Search bar on top."
    },
    "Messagerie": {
      "elements": "Slack-like interface. Left sidebar for channels (Accueil, Karting), main area for chat."
    }
  },
  "instructions_to_main_agent": [
    "Use pure HTML + Tailwind for layouts. Avoid heavy Shadcn wrapper components for structural layouts to maintain the bento-grid and asymmetrical design.",
    "For interactive elements (Dropdowns, Modals, Calendars), use Shadcn UI but heavily customize the classes to match the rounded-2xl glassmorphism style.",
    "Enforce data-testid on ALL interactive elements (buttons, links, forms).",
    "Use Lucide-react for all icons.",
    "Implement the specific Sidebar (midnight blue) and content area (light gray bg + glass white cards) aesthetic.",
    "Use the exact hex codes provided in the colors section for states."
  ]
}